##how to assign multiple variables at once
```{r}
library(zeallot)
names <- c("v1","v2","v3")
c(var1, var2, var3) %<-% names[c(1,2,3)]

#example using above operator to fix column names for multiple dataframes at once
names <- c("Term","Term","Term")
c(colnames(df)[1],colnames(df2)[1],colnames(df3)[1]) %<-% names[c(1,2,3)]
```

## drop duplicates from a dataframe
  # Drop rows that are completely identical across all columns
  df_clean <- df %>% distinct()

  # Drop duplicates based on ONE column (keeps the first occurrence)
  # NOTE: .keep_all = TRUE ensures you don't lose the other columns
  df_clean <- df %>% distinct(column_name, .keep_all = TRUE)

  # Drop duplicates based on MULTIPLE specific columns
  df_clean <- df %>% distinct(col1, col2, .keep_all = TRUE)



# merge two data frames by ID
```{r}
