##how to figure out which column headers don't match
```{r}
df <- data.frame(
  df1 = names(k12_18),
  df2 = names(k12_19))
for (row in seq_len(nrow(df))) {
  if (df[row,1]==df[row,2]) {print("TRUE")} else {print(paste(df[row,1],"FALSE",df[row,2]))}
}
```
